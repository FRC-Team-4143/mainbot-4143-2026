<?xml version="1.0" encoding="UTF-8"?>
<!-- Center start: drive out (intake on "Intake Out"), wait for partners, drive back, shoot. -->
<root BTCPP_format="4" main_tree_to_execute="CitrusSynergy">
  <include path="lib/common.xml"/>

  <BehaviorTree ID="CitrusSynergy">
    <Sequence>
      <SetShooterTarget target="HUB"/>
      <SetShooterState state="IDLE"/>
      <SetIntakeState state="STORE"/>
      <Sleep name="Settle" msec="1000"/>

      <ParallelDeadline name="DriveP1">
        <FollowTrajectory trajectory="SynergyP1" end_state="IDLE"/>
        <SubTree ID="IntakeOnEvent" event="Intake Out" state="INTAKE"/>
      </ParallelDeadline>

      <Delay name="MiddleWait" delay_msec="{middle_wait_msec}">
        <FollowTrajectory trajectory="SynergyP2" end_state="IDLE"/>
      </Delay>

      <SubTree ID="ShootFor" duration_msec="2000"/>
    </Sequence>
  </BehaviorTree>

  <TreeNodesModel>
    <SubTree ID="CitrusSynergy">
      <input_port name="middle_wait_msec" type="int" default="3000">Wait for other robots to clear the middle before SynergyP2</input_port>
    </SubTree>
  </TreeNodesModel>
</root>
