<?xml version="1.0" encoding="UTF-8"?>
<!-- Left trench start: shoot preload, then swipe through the trench twice, shooting after each. -->
<root BTCPP_format="4" main_tree_to_execute="Left_Trench_Trench_Swipe">
  <include path="lib/common.xml"/>

  <BehaviorTree ID="Left_Trench_Trench_Swipe">
    <Sequence>
      <SetShooterTarget target="HUB"/>
      <SetShooterState state="IDLE"/>

      <Parallel name="Drive LTrenchStartTrenchReturn" success_count="1">
        <FollowTrajectory trajectory="LTrenchStartTrenchReturn" end_state="FIELD_CENTRIC_ROTATION_LOCK"/>
        <SubTree ID="IntakeOnEvent" event="Intake Out" state="INTAKE"/>
      </Parallel>

      <SubTree ID="ShootFor" duration_msec="3500"/>
      <SetShooterState state="IDLE"/>
      <SetIntakeState state="INTAKE"/>

      <FollowTrajectory trajectory="LTrenchSwipeTrenchReturn" end_state="FIELD_CENTRIC_ROTATION_LOCK" min_time="1"/>

      <SubTree ID="ShootFor" duration_msec="3500"/>
      <SetShooterState state="IDLE"/>
      <SetIntakeState state="INTAKE"/>

      <FollowTrajectory trajectory="LTrenchSwipeTrenchReturn" end_state="FIELD_CENTRIC_ROTATION_LOCK" min_time="1"/>
    </Sequence>
  </BehaviorTree>
</root>
