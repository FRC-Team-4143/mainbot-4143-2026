<?xml version="1.0" encoding="UTF-8"?>
<!-- Right bump start (not in the chooser, like the Java version): shoot preload, then swipe twice. -->
<root BTCPP_format="4" main_tree_to_execute="Right_Bump_Bump_Swipe">
  <include path="../lib/common.xml"/>

  <BehaviorTree ID="Right_Bump_Bump_Swipe">
    <Sequence>
      <SetShooterTarget target="HUB"/>
      <SetShooterState state="IDLE"/>

      <Parallel name="Drive RBumpStartBumpReturn" success_count="1">
        <FollowTrajectory trajectory="RBumpStartBumpReturn" end_state="FIELD_CENTRIC_ROTATION_LOCK"/>
        <SubTree ID="IntakeOnEvent" event="Intake Out" state="INTAKE"/>
      </Parallel>

      <SubTree ID="ShootFor" duration_msec="3500"/>
      <SetShooterState state="IDLE"/>
      <SetIntakeState state="SQUEEZE_HOLD"/>

      <Parallel name="Drive RBumpSwipeBumpReturn" success_count="1">
        <FollowTrajectory trajectory="RBumpSwipeBumpReturn" end_state="FIELD_CENTRIC_ROTATION_LOCK" min_time="1"/>
        <SubTree ID="IntakeOnEvent" event="Intake Out" state="INTAKE"/>
      </Parallel>

      <SubTree ID="ShootFor" duration_msec="3500"/>
      <SetShooterState state="IDLE"/>
      <SetIntakeState state="SQUEEZE_HOLD"/>

      <Parallel name="Drive RBumpSwipeBumpReturn" success_count="1">
        <FollowTrajectory trajectory="RBumpSwipeBumpReturn" end_state="FIELD_CENTRIC_ROTATION_LOCK" min_time="1"/>
        <SubTree ID="IntakeOnEvent" event="Intake Out" state="INTAKE"/>
      </Parallel>
    </Sequence>
  </BehaviorTree>
</root>
